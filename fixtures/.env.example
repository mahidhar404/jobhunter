# .env.example — copy to a real .env (git-ignored) and fill in.
# These are placeholders; never commit real keys.

# --- Data location indirection (see docs/RESTRUCTURE_PROPOSAL.md) ---
# Where real PII/secrets/artifacts live. Defaults to repo root today; point at ./private after migration.
# JOBHUNTER_PRIVATE_DIR=./private
# JOBHUNTER_FIXTURES_DIR=./fixtures

# Optional overrides already supported by the code:
# FASTFILL_OPTION_MAPPINGS=./private/option_mappings.json

# --- Fastfill safety switches (keep OFF for shared/dummy use) ---
# Real profile PII is used ONLY when all of these are set. Leave unset to stay in dummy mode.
# FASTFILL_ALLOW_REAL=0
# FASTFILL_REAL_PROFILE=0
# TEST_MODE=1

# --- LLM / API keys used by tooling (fill your own) ---
# OPENAI_API_KEY=sk-your-key-here
# DEEPSEEK_API_KEY=your-key-here
# ANTHROPIC_API_KEY=your-key-here

# --- Skyvern runtime (see skyvern_runtime/) ---
# Skyvern keeps its own secrets in skyvern_runtime/.env and skyvern_runtime/.secrets.env (both git-ignored).
# Refer to Skyvern's own docs for the exact variable names it expects.
