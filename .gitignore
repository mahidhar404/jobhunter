# the accumulated learning seed consulted on fresh clones, not disposable cache.
scripts/fastfill/replay_cache.json
partyrock_chrome_profile/
dashboard_chrome_profile/
dashboard_ui_profile/
resumes/

# Python / local envs
.venv/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Skyvern runtime noise
skyvern_runtime/venv/
skyvern_runtime/*.log
skyvern_runtime/videos/
